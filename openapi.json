{
  "openapi": "3.1.0",
  "info": {
    "title": "API de gestion de produits",
    "description": "API REST pour gérer le catalogue de produits, les catégories et le stock",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Produits",
      "description": "Gestion du catalogue de produits et du stock"
    },
    {
      "name": "Catégories",
      "description": "Gestion des catégories de produits"
    }
  ],
  "paths": {
    "/api/v1/products/{id}": {
      "get": {
        "tags": [
          "Produits"
        ],
        "summary": "Récupérer un produit par son identifiant",
        "operationId": "findById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du produit",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Produit trouvé",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "description": "Identifiant non numérique",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Produit introuvable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Produits"
        ],
        "summary": "Modifier un produit (remplace toutes ses données)",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du produit",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Produit modifié",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Produit ou catégorie introuvable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "SKU déjà utilisé par un autre produit",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Produits"
        ],
        "summary": "Supprimer un produit",
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du produit",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "204": {
            "description": "Produit supprimé"
          },
          "404": {
            "description": "Produit introuvable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": [
          "Produits"
        ],
        "summary": "Lister les produits (pagination, tri, filtres)",
        "operationId": "search",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Numéro de page, à partir de 0",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "Taille de page, de 1 à 100",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "maximum": 100,
              "minimum": 1
            },
            "example": 10
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Tri : champ,direction (ex. price,desc)",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Sort"
            },
            "example": "price,desc"
          },
          {
            "name": "name",
            "in": "query",
            "description": "Le nom contient ce texte (sans tenir compte des majuscules)",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "ordi"
          },
          {
            "name": "categoryId",
            "in": "query",
            "description": "Identifiant de catégorie",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          },
          {
            "name": "minPrice",
            "in": "query",
            "description": "Prix minimum",
            "required": false,
            "schema": {
              "type": "number"
            },
            "example": 1000
          },
          {
            "name": "maxPrice",
            "in": "query",
            "description": "Prix maximum",
            "required": false,
            "schema": {
              "type": "number"
            },
            "example": 500000
          }
        ],
        "responses": {
          "200": {
            "description": "Page de produits",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseProductResponse"
                }
              }
            }
          },
          "400": {
            "description": "Paramètre invalide (taille, tri, prix...)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Produits"
        ],
        "summary": "Créer un produit",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Produit créé ; l'en-tête Location donne son adresse",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Catégorie introuvable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "SKU déjà utilisé",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": [
          "Catégories"
        ],
        "summary": "Lister les catégories",
        "operationId": "findAll",
        "responses": {
          "200": {
            "description": "Liste des catégories, triée par nom",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Catégories"
        ],
        "summary": "Créer une catégorie",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Catégorie créée",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Nom absent ou trop long",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Une catégorie porte déjà ce nom",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products/{id}/stock": {
      "patch": {
        "tags": [
          "Produits"
        ],
        "summary": "Ajuster le stock (entrée si delta > 0, sortie si delta < 0)",
        "operationId": "adjustStock",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du produit",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockAdjustmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stock ajusté",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "400": {
            "description": "delta absent ou égal à 0",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Produit introuvable",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Stock insuffisant pour cette sortie",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductRequest": {
        "type": "object",
        "description": "Données d'un produit à créer ou à modifier",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Référence unique du produit (RG2)",
            "example": "LAP-001",
            "minLength": 1,
            "pattern": "^[A-Z0-9-]{3,20}$"
          },
          "name": {
            "type": "string",
            "description": "Nom du produit (RG1)",
            "example": "Ordinateur portable 15 pouces",
            "maxLength": 100,
            "minLength": 3
          },
          "description": {
            "type": "string",
            "description": "Description facultative (RG8)",
            "example": "8 Go de RAM, SSD 256 Go",
            "maxLength": 500,
            "minLength": 0
          },
          "price": {
            "type": "number",
            "description": "Prix strictement positif, deux décimales au plus (RG3)",
            "example": 349000
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Quantité en stock, supérieure ou égale à 0 (RG4)",
            "example": 12,
            "minimum": 0
          },
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "description": "Identifiant d'une catégorie existante (RG5)",
            "example": 1
          }
        },
        "required": [
          "categoryId",
          "name",
          "price",
          "quantity",
          "sku"
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "Format unique de toutes les réponses d'erreur",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Horodatage de l'erreur (UTC)",
            "example": "2026-11-23T09:35:12Z"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Statut HTTP",
            "example": 404
          },
          "code": {
            "type": "string",
            "description": "Code d'erreur stable, exploitable par un programme",
            "example": "PRODUCT_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Message lisible",
            "example": "Produit introuvable : id=99"
          },
          "path": {
            "type": "string",
            "description": "Chemin de la requête",
            "example": "/api/v1/products/99"
          },
          "violations": {
            "type": "array",
            "description": "Erreurs par champ (vide si aucune)",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            }
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "description": "Erreur de validation sur un champ",
        "properties": {
          "field": {
            "type": "string",
            "description": "Champ ou paramètre en erreur",
            "example": "price"
          },
          "message": {
            "type": "string",
            "description": "Explication de l'erreur",
            "example": "Le prix doit être supérieur à 0"
          }
        }
      },
      "ProductResponse": {
        "type": "object",
        "description": "Produit renvoyé par l'API",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Identifiant généré",
            "example": 7
          },
          "sku": {
            "type": "string",
            "description": "Référence unique",
            "example": "LAP-001"
          },
          "name": {
            "type": "string",
            "description": "Nom du produit",
            "example": "Ordinateur portable 15 pouces"
          },
          "description": {
            "type": "string",
            "description": "Description",
            "example": "8 Go de RAM, SSD 256 Go"
          },
          "price": {
            "type": "number",
            "description": "Prix",
            "example": 349000
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Quantité en stock",
            "example": 12
          },
          "categoryName": {
            "type": "string",
            "description": "Nom de la catégorie",
            "example": "Informatique"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de création (UTC)",
            "example": "2026-11-23T09:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de dernière modification (UTC)",
            "example": "2026-11-23T09:30:00Z"
          }
        }
      },
      "CategoryRequest": {
        "type": "object",
        "description": "Catégorie à créer",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nom unique de la catégorie",
            "example": "Informatique",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "CategoryResponse": {
        "type": "object",
        "description": "Catégorie renvoyée par l'API",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Identifiant généré",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nom de la catégorie",
            "example": "Informatique"
          }
        }
      },
      "StockAdjustmentRequest": {
        "type": "object",
        "description": "Ajustement du stock : positif pour une entrée, négatif pour une sortie",
        "properties": {
          "delta": {
            "type": "integer",
            "format": "int32",
            "description": "Quantité à ajouter (positive) ou à retirer (négative), jamais 0",
            "example": -3
          }
        },
        "required": [
          "delta"
        ]
      },
      "Sort": {
        "type": "object",
        "properties": {
          "sort": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PageResponseProductResponse": {
        "type": "object",
        "description": "Une page de résultats",
        "properties": {
          "content": {
            "type": "array",
            "description": "Éléments de la page",
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "Numéro de la page (à partir de 0)",
            "example": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Taille de la page",
            "example": 10
          },
          "totalElements": {
            "type": "integer",
            "format": "int64",
            "description": "Nombre total d'éléments",
            "example": 42
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "description": "Nombre total de pages",
            "example": 5
          }
        }
      }
    }
  }
}
